# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (AES-256-GCM key, base64-encoded 32 bytes)
# Generate with: node -e "require('crypto').randomBytes(32).pipe(process.stdout)" | base64
REFRESH_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# Google OAuth (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google/callback

# Email (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Cron security (any random string — used to authenticate Vercel cron calls)
CRON_SECRET=a-random-secret-string

# App URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
